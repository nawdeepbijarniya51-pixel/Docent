# ========== LLM & Embeddings (Groq + Hugging Face) ==========
# Groq API Key — for all LLM calls (routing, rewriting, answer generation)
# Get free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face API Token — for embeddings (BGE-M3 model)
# Get free token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_token_here

# ========== Reranking (Cohere) ==========
# Cohere API Key — for cross-encoder reranking
# Get free key at: https://dashboard.cohere.com/
COHERE_API_KEY=your_cohere_api_key_here

# ========== Vector Store (Qdrant) ==========
# Qdrant Cloud API Key — vector database for embeddings
# Get free account at: https://qdrant.tech/ (free tier available)
QDRANT_API_KEY=your_qdrant_api_key_here

# Qdrant Cloud URL — your vector store endpoint
# Example: https://your-cluster.us-west-2-0.aws.cloud.qdrant.io
QDRANT_URL=https://your-qdrant-url-here.us-west-2-0.aws.cloud.qdrant.io

# ========== CORS (Frontend Origins) ==========
# Comma-separated list of allowed frontend origins
# For local dev: http://localhost:3000,http://127.0.0.1:8000
# For production: your-domain.com,www.your-domain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
